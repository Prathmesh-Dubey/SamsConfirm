{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "-l", "5173", "."],
      "port": 5173
    },
    {
      "name": "gen-med",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8990", "--directory", "S:/Projects/gen-med"],
      "port": 8990
    },
    {
      "name": "portfolio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "S:/Projects/portfolio", "run", "dev", "--", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "portfolio-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "S:/Projects/portfolio", "run", "start", "--", "-p", "3200"],
      "port": 3200
    }
  ]
}
